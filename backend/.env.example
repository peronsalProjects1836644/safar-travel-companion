# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---------------------------------------------------------------
# Random string, at least 32 characters. Generate: python -m scripts.gen_secret
JWT_SECRET=
# Local: mongodb://localhost:27017   Atlas: the mongodb+srv:// string from the Atlas "Connect" screen
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smart_tour

# --- OpenAI (the only paid service) -------------------------------------------
# Leave the key empty to run without AI: trips then use the built-in planner and chat is switched off.
OPENAI_API_KEY=
# Run `python -m scripts.check_openai` to see the exact model names your key can use.
OPENAI_MODEL=gpt-6-luna
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_GLOBAL=300

# --- Free services ------------------------------------------------------------
# A real email. OpenStreetMap's Nominatim requires it in the User-Agent. Place search is off without it.
NOMINATIM_CONTACT_EMAIL=

# --- Admin account (created on first start if both are set) -------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Deployment ---------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true on Vercel (one trusted proxy in front) so rate limits see the real client IP.
TRUST_PROXY=false
ENVIRONMENT=development
